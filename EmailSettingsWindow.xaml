<Window x:Class="EmailWithAttachedFile.EmailSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Email Settings" Height="420" Width="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Label Content="Tenant ID:" Grid.Row="0" VerticalAlignment="Center"/>
        <TextBox x:Name="txtTenantId" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="5"/>

        <Label Content="Client ID:" Grid.Row="1" VerticalAlignment="Center"/>
        <TextBox x:Name="txtClientId" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="5"/>

        <Label Content="Email Address:" Grid.Row="2" VerticalAlignment="Center"/>
        <TextBox x:Name="txtEmailAddress" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="5"/>

        <Label Content="Email Author:" Grid.Row="3" VerticalAlignment="Center"/>
        <TextBox x:Name="txtEmailAuthor" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="5"/>

        <Label Content="Template File:" Grid.Row="4" VerticalAlignment="Center"/>
        <TextBox x:Name="txtTemplateFile" Grid.Row="4" Grid.Column="1" Margin="5"/>
        <Button Content="..." Grid.Row="4" Grid.Column="2" Width="30" Margin="5" Click="BtnBrowseTemplate_Click"/>

        <Label Content="Input File:" Grid.Row="5" VerticalAlignment="Center"/>
        <TextBox x:Name="txtInputFile" Grid.Row="5" Grid.Column="1" Margin="5"/>
        <Button Content="..." Grid.Row="5" Grid.Column="2" Width="30" Margin="5" Click="BtnBrowseInput_Click"/>

        <Label Content="Mail Subject:" Grid.Row="6" VerticalAlignment="Center"/>
        <TextBox x:Name="txtMailSubject" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="5"/>

        <Label Content=" Attachments:" Grid.Row="7" VerticalAlignment="Top" Margin="0,5,0,0"/>
        <ListBox x:Name="attachements" Grid.Row="7" Grid.Column="1" Margin="5"/>
        <StackPanel Grid.Row="7" Grid.Column="2" VerticalAlignment="Top">
            <Button Content="Add" Margin="5" Width="60" Click="BtnAddAttachment_Click"/>
            <Button Content="Remove" Margin="5" Width="60" Click="BtnRemoveAttachment_Click"/>
        </StackPanel>
        <TextBlock Grid.Row="8" Grid.ColumnSpan="3" Text="__" Name="textSettingsFileName" FontSize="10" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Right" Margin="0,20,0,10">
            <Button x:Name="btnSave" Content="Save" Width="80" Margin="5" Click="BtnSave_Click" IsDefault="True"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Margin="5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>