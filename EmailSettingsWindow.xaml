<Window x:Class="EmailWithAttachedFile.EmailSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Email Settings" Height="680" Width="550" WindowStartupLocation="CenterOwner"
         FontWeight="DemiBold" FontSize="12" ResizeMode="CanResizeWithGrip">
    <Grid Margin="15" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Template File -->
            <RowDefinition Height="Auto"/> <!-- Input File -->
            <RowDefinition Height="Auto"/> <!-- Mail Subject -->
            <RowDefinition Height="Auto"/> <!-- Group: Account -->
            <RowDefinition Height="Auto"/> <!-- Group: Columns -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Content="Template File:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtTemplateFile" Grid.Column="1" Margin="5"/>
            <Button Content="..." Grid.Column="2" Width="30" Margin="5" Click="BtnBrowseTemplate_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Content="Input File:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtInputFile" Grid.Column="1" Margin="5"/>
            <Button Content="..." Grid.Column="2" Width="30" Margin="5" Click="BtnBrowseInput_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Content="Mail Subject:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtMailSubject" Grid.Column="1" Grid.ColumnSpan="2" Margin="5"/>
        </Grid>

        <GroupBox Header="Account Information" Grid.Row="3" Margin="0,10,0,10" BorderThickness="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="Tenant ID:" Grid.Row="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtTenantId" Grid.Row="0" Grid.Column="1" Margin="5"/>
                <Label Content="Client ID:" Grid.Row="1" VerticalAlignment="Center"/>
                <TextBox x:Name="txtClientId" Grid.Row="1" Grid.Column="1" Margin="5"/>
                <Label Content="Email Address:" Grid.Row="2" VerticalAlignment="Center"/>
                <TextBox x:Name="txtEmailAddress" Grid.Row="2" Grid.Column="1" Margin="5"/>
                <Label Content="Email Author:" Grid.Row="3" VerticalAlignment="Center"/>
                <TextBox x:Name="txtEmailAuthor" Grid.Row="3" Grid.Column="1" Margin="5"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="CSV Column Mapping" Grid.Row="4" Margin="0,10,0,10" BorderThickness="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="Name Column:" Grid.Row="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtNameColumn" Grid.Row="0" Grid.Column="1" Margin="5"/>
                <Label Content="Email Column:" Grid.Row="1" VerticalAlignment="Center"/>
                <TextBox x:Name="txtEmailColumn" Grid.Row="1" Grid.Column="1" Margin="5"/>
                <Label Content="File Column:" Grid.Row="2" VerticalAlignment="Center"/>
                <TextBox x:Name="txtFileNameColumn" Grid.Row="2" Grid.Column="1" Margin="5"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Content=" Attachments:" VerticalAlignment="Top" Margin="0,5,0,0"/>
            <ListBox x:Name="attachements" Grid.Column="1" Margin="5" MinHeight="60"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <Button Content="Add" Margin="5" Width="60" Click="BtnAddAttachment_Click"/>
                <Button Content="Remove" Margin="5" Width="60" Click="BtnRemoveAttachment_Click"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Text="__" Name="textSettingsFileName" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>

        <StackPanel Orientation="Horizontal" Grid.Row="7" Grid.ColumnSpan="3" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnSave" Content="Save" Width="80" Margin="5" Click="BtnSave_Click" IsDefault="True"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Margin="5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>